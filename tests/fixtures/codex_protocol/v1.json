{
  "_comment": "Pinned Codex App Server contract Bridge v1 targets. The real Codex App Server schema is experimental and version-gated; this fixture is the single source of truth shared by the adapter and the fake server so they cannot drift. Experiment F validates it against a live Codex before the live tests are trusted.",
  "protocol_version": "codex-app-server/1",
  "supported_versions": ["codex-app-server/1"],
  "client_requests": {
    "initialize": {
      "params": ["protocolVersion", "clientInfo"],
      "result": ["protocolVersion", "serverInfo", "capabilities"]
    },
    "turn/start": {
      "params": ["thread_id", "input"],
      "result": ["turn_id"]
    }
  },
  "client_notifications": ["initialized"],
  "server_notifications": {
    "thread/started": ["thread_id"],
    "thread/resume": ["thread_id"],
    "runtime/status": ["status"],
    "turn/started": ["turn_id", "thread_id"],
    "item/agent_message_delta": ["turn_id", "delta"],
    "item/agent_message": ["turn_id", "text"],
    "turn/completed": ["turn_id", "thread_id"]
  },
  "forbidden_in_v1": ["turn/steer"],
  "runtime_status_values": ["idle", "working"],
  "launch_argv": ["{binary}", "app-server", "--listen", "unix://{socket_path}"]
}
